{
  "name": "livebuy-react-native-reference-ui",
  "version": "1.8.0",
  "description": "Reference-UI pixel-rendering layer for the Livebuy React Native SDK (binds the livebuy-react-native-ui Default template view-models)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ariesweng/livebuy-react-native-reference-ui.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:harness": "jest harness"
  },
  "peerDependencies": {
    "livebuy-react-native-ui": "^1.8.0",
    "react": "*",
    "react-native": "*",
    "react-native-svg": "15.15.5",
    "react-native-video": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.0.0",
    "jest": "^29.7.0",
    "livebuy-react-native": "file:../react-native",
    "livebuy-react-native-ui": "file:../react-native-ui",
    "react": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "__DEV__": false
    },
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/test-support/react-native.mock.tsx",
      "^react-native-video$": "<rootDir>/test-support/react-native-video.mock.tsx",
      "^react-native-svg$": "<rootDir>/test-support/react-native-svg.mock.tsx",
      "\\.(png|jpe?g|gif)$": "<rootDir>/test-support/imageAssetMock.js"
    }
  }
}
